{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "A mod that adds a toggle in the \"Open To Lan\" menu to disable online-mode on the integrated server",
  "authors": [
    "Aeroshide"
  ],
  "contact": {},
  "license": "GPL-3.0",
  "icon": "assets/${id}/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.aeroshide.offlinelan.OfflineLAN"
    ]
  },
  "mixins": [
    "offlinelan.mixins.json"
  ],
  "accessWidener": "offlinelan.ct",
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "${minecraft}"
  }
}
